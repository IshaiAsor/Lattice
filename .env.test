# Dummy, non-secret credentials for the ephemeral integration-test stack (compose.test.yaml).
# Safe to commit — this stack is disposable (`npm run test:e2e:down` drops its volumes) and
# never holds real data. Do NOT copy these values into the real .env used by compose.yaml.
#
# Usage: docker compose -f compose.test.yaml --env-file .env.test <command>
#        npm run test:e2e:up / npm run test:e2e / npm run test:e2e:down

# --- Postgres ---
DB_NAME=lattice_test
DB_USER=postgres
DB_PASSWORD=test
BACKEND_DB_USER=backend_test
BACKEND_DB_PASSWORD=test
EMQX_DB_USERNAME=emqx_test
EMQX_DB_PASSWORD=test

# --- EMQX ---
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=test12345
MQTT_APP_USERNAME=app_test
MQTT_APP_PASSWORD=test
# Host port tests/e2e/helpers/stack.ts connects to (shifted off compose.yaml's 1883 so both
# stacks can run at once) — see compose.test.yaml's emqx service and device-gateway's
# provisioning-response env vars, both of which read this same var.
MQTT_PORT=11883

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Redis / Valkey ---
REDIS_USER=default
REDIS_PASSWORD=test

# --- JWT ---
JWT_SECRET=integration-test-secret-do-not-use-in-prod

# --- Seeded admin login (prisma/seed.ts) — matches tests/e2e/helpers/stack.ts login()'s default ---
OWNER_USERNAME=admin
OWNER_PASSWORD=admin

# --- Optional (`--profile full`: ml-executor, google-home) ---
# Default (unset) resolves to compose.test.yaml's own cluster-tunnel-test service.
OLLAMA_URL=
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_SIGN_IN_CLIENT_ID=
GOOGLE_SIGN_IN_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_KEY=
