// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Tables are ordered by dependency tier (0 → 7). Keep prisma/SCHEMA.md in sync
// with any change here (mermaid ERD + per-table examples).

generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ═══ Tier 0 — External catalog (Google Smart Home) ═════════════════════════════

model GoogleActionType {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  value      String   @unique @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(6)

  capabilities DeviceCapability[]

  @@map("google_action_types")
}

model GoogleDeviceTrait {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(255)
  value            String   @unique @db.VarChar(255)
  valid_parameters Json?
  created_at       DateTime @default(now()) @db.Timestamp(6)

  capability_traits DeviceCapabilityTrait[]
  action_defaults   UserDeviceAction[]

  @@map("google_device_traits")
}

// ═══ Tier 1 — Device & ML catalog ══════════════════════════════════════════════

model Device {
  id           Int      @id @default(autoincrement())
  type         String   @db.VarChar(255)
  version      String   @db.VarChar(255)
  default_name String   @unique @db.VarChar(255)
  // Sealed = factory-soldered device: pins/actions are fixed and composed by an admin into a
  // SealedTemplate (not user-configurable). Seeded from the firmware manifest's `sealed` marker
  // (SEALED build flag); regular types stay false. Same catalog pipeline either way.
  is_sealed    Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @default(now()) @db.Timestamp(6)

  capabilities         DeviceCapability[]
  user_devices         UserDevice[]       @relation("CurrentDevice")
  pending_user_devices UserDevice[]       @relation("PendingDevice")

  @@unique([type, version])
  @@map("devices")
}

model DeviceCapability {
  id                        Int      @id @default(autoincrement())
  device_id                 Int
  capability_key            String   @db.VarChar(64)
  label                     String   @db.VarChar(255)
  implementation_type       String   @db.VarChar(64)
  mqtt_action_type          String   @db.VarChar(32)
  mqtt_action_name          String   @db.VarChar(64)
  min_telemetry_interval_ms Int?
  google_type_id            Int?
  created_at                DateTime @default(now()) @db.Timestamp(6)

  device              Device                    @relation(fields: [device_id], references: [id], onDelete: Cascade)
  google_type         GoogleActionType?         @relation(fields: [google_type_id], references: [id], onDelete: SetNull)
  traits              DeviceCapabilityTrait[]
  pins                DeviceCapabilityPin[]
  configurations      CapabilityConfiguration[]
  user_device_actions UserDeviceAction[]

  @@unique([device_id, capability_key])
  @@map("device_capabilities")
}

// One row per behavior a capability supports (catalog-declared, firmware-generated). An
// action is no longer "a command" or "a telemetry" — it exposes a set of behaviors:
//   • command   — actuator: accepts value commands (validation comes from the capability's traits)
//   • interval  — cyclic sensor read (min_interval_ms = hardware floor from firmware)
//   • on_demand — server-triggered read / camera capture
// Per-behavior limits are TYPED columns (nullable, set only where meaningful — same pattern as
// user_rule_conditions / pipeline_triggers), not JSON. New behavior fields get a migration.
model CapabilityConfiguration {
  id              Int      @id @default(autoincrement())
  capability_id   Int
  behavior        String   @db.VarChar(20)
  min_interval_ms Int?
  created_at      DateTime @default(now()) @db.Timestamp(6)

  capability          DeviceCapability          @relation(fields: [capability_id], references: [id], onDelete: Cascade)
  user_configurations UserActionConfiguration[]

  @@unique([capability_id, behavior])
  @@map("capability_configurations")
}

model DeviceCapabilityTrait {
  id              Int     @id @default(autoincrement())
  capability_id   Int
  google_trait_id Int
  is_default      Boolean @default(false)

  capability   DeviceCapability  @relation(fields: [capability_id], references: [id], onDelete: Cascade)
  google_trait GoogleDeviceTrait @relation(fields: [google_trait_id], references: [id], onDelete: Cascade)

  @@unique([capability_id, google_trait_id])
  @@map("device_capability_traits")
}

model DeviceCapabilityPin {
  id            Int    @id @default(autoincrement())
  capability_id Int
  key           String @db.VarChar(50)
  label         String @db.VarChar(100)
  mode          String @db.VarChar(20)

  capability       DeviceCapability      @relation(fields: [capability_id], references: [id], onDelete: Cascade)
  user_action_pins UserDeviceActionPin[]

  @@unique([capability_id, key])
  @@map("device_capability_pins")
}

// ─── Sealed device templates (admin authoring layer over the shared catalog) ────────
// A sealed device's config is composed ONCE by an admin instead of per-user: which catalog
// capabilities to activate, the fixed GPIO per pin slot, and which behaviors. Entries reference
// catalog capabilities BY KEY (capability_key / pin_slot_key), not by row id, so one template
// resolves across a firmware version RANGE (see targets). On provision a sealed device
// auto-materializes its resolved template into user_device_actions (device-gateway) — the user
// configures nothing. The catalog itself stays append-only; only these tables + user instances
// are mutable.

model SealedTemplate {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(255)
  status     String   @default("draft") @db.VarChar(20) // draft | released (only released materializes)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)

  targets         SealedTemplateTarget[]
  entries         SealedTemplateEntry[]
  blueprint_slots BlueprintSlot[]

  @@map("sealed_templates")
}

// Which (device type, firmware version range) a template covers. A device matches when
// type == device_type AND version_min <= version <= version_max (inclusive, vX.Y.Z compare).
model SealedTemplateTarget {
  id          Int    @id @default(autoincrement())
  template_id Int
  device_type String @db.VarChar(255)
  version_min String @db.VarChar(64)
  version_max String @db.VarChar(64)

  template SealedTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@index([device_type])
  @@map("sealed_template_targets")
}

// One activated capability in the template, resolved per version by capability_key.
model SealedTemplateEntry {
  id                  Int     @id @default(autoincrement())
  template_id         Int
  capability_key      String  @db.VarChar(64)
  // Per-instance MQTT routing verb (mirrors UserDeviceAction.mqtt_action_name): base capability
  // name for the first instance, <base>_2/_3/… for repeats. A capability may appear more than once
  // per template (e.g. 8 i2c_socket_8 channels), so this — not capability_key — is the unique key.
  mqtt_action_name    String  @db.VarChar(64)
  action_label        String  @db.VarChar(255)
  default_trait_value String? @db.VarChar(255) // GoogleDeviceTrait.value, resolved per version
  sort_order          Int     @default(0)

  template  SealedTemplate                @relation(fields: [template_id], references: [id], onDelete: Cascade)
  pins      SealedTemplateEntryPin[]
  behaviors SealedTemplateEntryBehavior[]

  @@unique([template_id, mqtt_action_name])
  @@map("sealed_template_entries")
}

// Fixed GPIO the admin assigned to a capability's pin slot (by DeviceCapabilityPin.key).
model SealedTemplateEntryPin {
  id           Int    @id @default(autoincrement())
  entry_id     Int
  pin_slot_key String @db.VarChar(50)
  pin_number   Int

  entry SealedTemplateEntry @relation(fields: [entry_id], references: [id], onDelete: Cascade)

  @@unique([entry_id, pin_slot_key])
  @@map("sealed_template_entry_pins")
}

// Enabled behavior + chosen values (mirrors user_action_configurations).
model SealedTemplateEntryBehavior {
  id                Int     @id @default(autoincrement())
  entry_id          Int
  behavior          String  @db.VarChar(20)
  interval_ms       Int?
  camera_resolution String? @db.VarChar(20)
  camera_transport  String? @db.VarChar(10)

  entry SealedTemplateEntry @relation(fields: [entry_id], references: [id], onDelete: Cascade)

  @@unique([entry_id, behavior])
  @@map("sealed_template_entry_behaviors")
}

model MlModel {
  id           Int      @id @default(autoincrement())
  kind         String   @db.VarChar(10)
  name         String   @db.VarChar(100)
  version      String   @db.VarChar(50)
  backend      String   @db.VarChar(20)
  model_file   String?  @db.VarChar(255)
  ollama_model String?  @db.VarChar(255)
  classes      Json?
  config       Json?
  created_at   DateTime @default(now()) @db.Timestamp(6)

  pipeline_stages           PipelineStage[]
  blueprint_template_stages BlueprintPipelineTemplateStage[]

  @@unique([kind, name, version])
  @@map("ml_models")
}

// ═══ Tier 2 — Identity ═════════════════════════════════════════════════════════

model User {
  id                       Int       @id @default(autoincrement())
  user_type                Int       @default(0)
  user_role                String    @default("user") @db.VarChar(50)
  user_name                String?   @unique @db.VarChar(255)
  password                 String?   @db.VarChar(255)
  google_id                String?   @unique @db.VarChar(255)
  email                    String    @unique @db.VarChar(255)
  full_name                String?   @db.VarChar(255)
  profile_picture_url      String?
  // Credential accounts start unverified and must confirm via an email link (F15.8) before
  // they can log in; Google accounts are created with email_verified = true (Google verified).
  email_verified           Boolean   @default(false)
  email_verification_token String?   @unique @db.VarChar(255)
  // Password-reset flow (F15.9): single-use token + expiry, cleared on use.
  password_reset_token     String?   @unique @db.VarChar(255)
  password_reset_expires   DateTime? @db.Timestamptz(6)
  terms_accepted_at        DateTime? @db.Timestamptz(6)
  // IANA zone name ("Asia/Jerusalem") — the clock every schedule this user writes is read against.
  // Null means the evaluating process's own zone, which is UTC in a container: that was the only
  // behaviour before, and it fired a 06:00 rule at 09:00 local. The client sets this from the
  // browser on first sign-in, so "local" is the default without anyone choosing it.
  timezone                 String?   @db.VarChar(64)
  created_at               DateTime? @default(now()) @db.Timestamptz(6)
  updated_at               DateTime? @default(now()) @db.Timestamptz(6)

  user_devices         UserDevice[]
  user_login_audit     UserLoginAudit[]
  user_rules           UserRule[]
  action_groups        UserActionGroup[]
  areas                Area[]
  scenes               Scene[]
  pipelines            Pipeline[]
  notification_prefs   NotificationPreference[]
  notification_history NotificationHistory[]
  push_subscriptions   PushSubscription[]
  blueprint_instances  BlueprintInstance[]
  device_commands      DeviceCommand[]

  @@map("users")
}

// Per-user, per-channel, per-event-type opt-in matrix (F15). A missing row means "use the
// service default" for that (channel, event_type); notification-service never assumes a row
// exists. enabled = false is an explicit opt-out.
model NotificationPreference {
  id         Int      @id @default(autoincrement())
  user_id    Int
  channel    String   @db.VarChar(32) // in_app | email | push | sms
  event_type String   @db.VarChar(64) // emergency | rule_fired | device_offline | ota_available | ...
  enabled    Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, channel, event_type])
  @@map("notification_preferences")
}

// Delivered/attempted notifications, backing the in-app inbox + unread badge (F15). One row per
// (user, notification) regardless of how many channels it fanned out to.
model NotificationHistory {
  id         Int       @id @default(autoincrement())
  user_id    Int
  event_type String    @db.VarChar(64)
  title      String    @db.VarChar(255)
  body       String
  data       Json? // rendering context / deep-link payload
  channels   String[] // channels this notification was delivered on
  read_at    DateTime? @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6) // soft-delete: hidden from inbox when set
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("notification_history")
}

// One row per subscribed browser/device (web-push). endpoint is the push service URL
// (FCM/Mozilla/etc — no fixed max length), unique so re-subscribing the same browser
// upserts rather than duplicates; p256dh/auth are the subscription's encryption keys.
model PushSubscription {
  id         Int      @id @default(autoincrement())
  user_id    Int
  endpoint   String   @unique @db.Text
  p256dh     String   @db.VarChar(255)
  auth       String   @db.VarChar(255)
  user_agent String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("push_subscriptions")
}

model MqttUser {
  id            Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(100)
  password_hash String    @db.VarChar(100)
  is_superuser  Boolean?  @default(false)
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  @@map("mqtt_user")
}

model UserLoginAudit {
  id         Int       @id @default(autoincrement())
  user_id    Int
  login_at   DateTime? @default(now()) @db.Timestamptz(6)
  ip_address String?   @db.VarChar(100)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_login_audit")
}

// ═══ Tier 3 — User devices & actions ═══════════════════════════════════════════

model UserDevice {
  id                       Int       @id @default(autoincrement())
  device_type_id           Int
  user_id                  Int
  mac_id                   String    @unique @db.VarChar(255)
  name                     String    @db.VarChar(255)
  online                   Boolean   @default(false)
  last_online_date         DateTime? @db.Timestamp(6)
  // Latest diagnostics from the device's MQTT heartbeat (WiFi RSSI in dBm + when it arrived).
  // Live-only — surfaced by the UI while online, ignored/nulled when offline.
  rssi                     Int?
  last_heartbeat_at        DateTime? @db.Timestamp(6)
  // Where the device is in setup. Written on provisioning INSERT only, so a re-provision
  // (factory reset, firmware update) never drags a configured device back into the wizard:
  //   provisioning → registered, no actions yet, setup unfinished ("Finish setup" in the list)
  //   active       → configured, or re-provisioned over an existing config
  status                   String    @default("active") @db.VarChar(20)
  current_firmware_version String?   @db.VarChar(64)
  pending_device_type_id   Int?
  pending_firmware_version String?   @db.VarChar(64)
  area_id                  Int?
  created_at               DateTime  @default(now()) @db.Timestamp(6)
  updated_at               DateTime  @default(now()) @db.Timestamp(6)

  device              Device                 @relation("CurrentDevice", fields: [device_type_id], references: [id], onDelete: Cascade)
  pending_device      Device?                @relation("PendingDevice", fields: [pending_device_type_id], references: [id], onDelete: SetNull)
  user                User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  area                Area?                  @relation(fields: [area_id], references: [id], onDelete: SetNull)
  user_device_actions UserDeviceAction[]
  rule_conditions     UserRuleCondition[]
  blueprint_bindings  BlueprintSlotBinding[]
  commands            DeviceCommand[]

  @@index([area_id])
  @@map("user_devices")
}

model UserActionGroup {
  id         Int      @id @default(autoincrement())
  user_id    Int
  name       String   @db.VarChar(255)
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)

  user    User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  actions UserDeviceAction[]

  @@unique([user_id, name])
  @@index([user_id, sort_order])
  @@map("user_action_groups")
}

// "These devices belong together." A user-createable grouping primitive (F10.0), independent of
// blueprints — a hand-built setup gets the same sectioned dashboard and area-scoped notifications
// as a derived one. A blueprint derive creates one and fills it. Devices and the automations that
// act on them (scenes/rules/pipelines) carry a nullable area_id; deleting an area never deletes a
// device or an automation (SetNull), it only un-groups them.
model Area {
  id         Int      @id @default(autoincrement())
  user_id    Int
  name       String   @db.VarChar(255)
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)

  user      User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  devices   UserDevice[]
  scenes    Scene[]
  rules     UserRule[]
  pipelines Pipeline[]
  instances BlueprintInstance[]

  @@unique([user_id, name])
  @@index([user_id, sort_order])
  @@map("areas")
}

model UserDeviceAction {
  id                    Int      @id @default(autoincrement())
  user_device_id        Int
  capability_id         Int
  group_id              Int?
  default_trait_id      Int?
  action_name           String   @db.VarChar(255)
  mqtt_action_name      String   @db.VarChar(64)
  current_state         String?  @db.Text
  status                String   @default("active") @db.VarChar(20)
  sort_order            Int      @default(0)
  telemetry_interval_ms Int?
  camera_resolution     String?  @db.VarChar(20)
  camera_transport      String?  @db.VarChar(10)
  created_at            DateTime @default(now()) @db.Timestamp(6)
  updated_at            DateTime @default(now()) @db.Timestamp(6)

  user_device       UserDevice                @relation(fields: [user_device_id], references: [id], onDelete: Cascade)
  capability        DeviceCapability          @relation(fields: [capability_id], references: [id], onDelete: Cascade)
  group             UserActionGroup?          @relation(fields: [group_id], references: [id], onDelete: SetNull)
  default_trait     GoogleDeviceTrait?        @relation(fields: [default_trait_id], references: [id], onDelete: SetNull)
  pins              UserDeviceActionPin[]
  configurations    UserActionConfiguration[]
  rule_actions      UserRuleAction[]
  rule_conditions   UserRuleCondition[]
  scene_members     SceneMember[]
  sensor_history    SensorHistory[]
  pipeline_sensors  PipelineSensor[]
  pipeline_triggers PipelineTrigger[]         @relation("PipelineTrig")
  commands          DeviceCommand[]

  @@index([user_device_id, mqtt_action_name])
  @@map("user_device_actions")
}

// One row per behavior the user has ENABLED on their action, with the chosen values (typed
// columns, nullable per behavior). Enabling interval + on_demand on a sensor is two rows; an
// on-demand-only sensor has one. Validated on save against the capability's
// CapabilityConfiguration rows (device-gateway). camera_resolution/camera_transport fold here
// off user_device_actions (an on_demand camera row); interval_ms is the chosen cadence.
model UserActionConfiguration {
  id                          Int      @id @default(autoincrement())
  user_device_action_id       Int
  capability_configuration_id Int
  behavior                    String   @db.VarChar(20)
  interval_ms                 Int?
  camera_resolution           String?  @db.VarChar(20)
  camera_transport            String?  @db.VarChar(10)
  created_at                  DateTime @default(now()) @db.Timestamp(6)
  updated_at                  DateTime @default(now()) @db.Timestamp(6)

  user_device_action       UserDeviceAction        @relation(fields: [user_device_action_id], references: [id], onDelete: Cascade)
  capability_configuration CapabilityConfiguration @relation(fields: [capability_configuration_id], references: [id], onDelete: Cascade)

  @@unique([user_device_action_id, behavior])
  @@map("user_action_configurations")
}

model UserDeviceActionPin {
  id                    Int @id @default(autoincrement())
  user_device_action_id Int
  capability_pin_id     Int
  pin_number            Int

  user_device_action UserDeviceAction    @relation(fields: [user_device_action_id], references: [id], onDelete: Cascade)
  capability_pin     DeviceCapabilityPin @relation(fields: [capability_pin_id], references: [id], onDelete: Cascade)

  @@unique([user_device_action_id, capability_pin_id])
  @@map("user_device_action_pins")
}

// ═══ Tier 4 — Automation (rules; emergencies are rules with is_emergency) ═══════

model UserRule {
  id                    Int       @id @default(autoincrement())
  user_id               Int
  name                  String    @db.VarChar(255)
  enabled               Boolean   @default(true)
  is_emergency          Boolean   @default(false)
  condition_operator    String    @default("AND") @db.VarChar(3)
  cooldown_seconds      Int       @default(60)
  last_triggered        DateTime? @db.Timestamp(6)
  area_id               Int?
  // Blueprint provenance (F10). blueprint_key names the template this was derived from and is
  // the reconcile identity; user_modified is set by the ordinary update path in rules.service
  // whenever the row belongs to an instance, and makes reconcile skip it and surface it as drift.
  blueprint_instance_id Int?
  blueprint_key         String?   @db.VarChar(64)
  // Set when this row came from a per_device template — which *binding* it belongs to (F11).
  // Reconcile identity is the pair (blueprint_key, blueprint_binding_id): several rows now share a
  // template key, one per bound device, and only the pair tells them apart.
  blueprint_binding_id  Int?
  // Phases this rule is active in (F10). Empty = every phase (the default); a non-empty set makes
  // the rule inert unless the instance's current phase key is in it. Gated at evaluation time, so
  // a phase change never rewrites the rule — same principle as @phase parameterization.
  phase_scope           String[]  @default([])
  user_modified         Boolean   @default(false)
  // Set when RECONCILE disabled this row (its template left the blueprint, or its device left the
  // fan-out selection), cleared when reconcile brings it back or the user toggles it by hand.
  // Without it reconcile cannot tell its own disable from the user's — and since toggling `enabled`
  // is deliberately NOT drift, a device that left a lifecycle and came back would stay dead while
  // reconcile happily reported "updated".
  disabled_by_reconcile Boolean   @default(false)
  created_at            DateTime  @default(now()) @db.Timestamp(6)
  updated_at            DateTime  @default(now()) @db.Timestamp(6)

  user               User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  area               Area?                 @relation(fields: [area_id], references: [id], onDelete: SetNull)
  blueprint_instance BlueprintInstance?    @relation(fields: [blueprint_instance_id], references: [id], onDelete: SetNull)
  blueprint_binding  BlueprintSlotBinding? @relation(fields: [blueprint_binding_id], references: [id], onDelete: SetNull)
  conditions         UserRuleCondition[]
  actions            UserRuleAction[]
  events             UserRuleEvent[]

  @@index([area_id])
  @@index([blueprint_instance_id])
  @@map("user_rules")
}

model UserRuleCondition {
  id             Int    @id @default(autoincrement())
  rule_id        Int
  condition_type String @db.VarChar(20) // threshold | device_status | schedule | vlm

  // threshold: reading from a sensor action vs a value
  user_device_action_id Int?
  operator              String? @db.VarChar(5)
  threshold_value       String? @db.VarChar(100)

  // device_status: a device is online/offline
  user_device_id Int?
  status_value   String? @db.VarChar(20)

  // schedule: time-of-day + days-of-week (0=Sun … 6=Sat)
  // HH:MM literal OR a reference (`@phase.light.on_time`) — see user_rule_actions.duration_seconds
  // for why these widened from VarChar(5) in F11.14. Resolved by `resolveClock` at match time.
  schedule_time String? @db.VarChar(100)
  schedule_days Int[]   @default([])
  // A schedule is one minute a day unless a WINDOW is given, in which case it repeats:
  // `schedule_time` opens it, `schedule_until` closes it (inclusive) and `schedule_every_minutes`
  // is the step — "06:00 to 17:30, every 10 minutes". Both window columns null = the single-time
  // shape every schedule had before, unchanged. How long the device then holds the state is the
  // action's own duration_seconds, not this: this says WHEN, that says HOW LONG.
  schedule_until  String? @db.VarChar(100)
  schedule_every_minutes Int?


  rule               UserRule          @relation(fields: [rule_id], references: [id], onDelete: Cascade)
  user_device_action UserDeviceAction? @relation(fields: [user_device_action_id], references: [id], onDelete: SetNull)
  user_device        UserDevice?       @relation(fields: [user_device_id], references: [id], onDelete: SetNull)

  @@map("user_rule_conditions")
}

model UserRuleAction {
  id                    Int    @id @default(autoincrement())
  rule_id               Int
  user_device_action_id Int
  target_state          String  @db.VarChar(255)
  // Seconds to wait before publishing. Literal OR reference; null/absent = publish now.
  delay_seconds         String? @db.VarChar(100)
  // How long the device should hold this state before returning itself to its resting one — passed
  // straight through to the firmware, which owns the timer (BaseCommandAction's duration auto-off).
  // Null = hold indefinitely, which is every action written before this existed.
  //
  // The platform used to express "on for a while" as a second action with a delay, but that timer
  // lived in automation-worker's memory: a restart inside the window lost the close and left the
  // valve open. The device's own timer cannot be lost that way, so the duration belongs there.
  //
  // Text since F11.14, holding a literal ("90") OR a reference ("@phase.water.seconds"). How long
  // to water is a property of the growth stage, not of the rule — while this was an integer the
  // only way to vary it per lifecycle was to duplicate the whole rule once per lifecycle.
  // `resolveSeconds` turns it into the number at dispatch time; unresolvable ⇒ hold indefinitely.
  duration_seconds      String? @db.VarChar(100)

  rule               UserRule         @relation(fields: [rule_id], references: [id], onDelete: Cascade)
  user_device_action UserDeviceAction @relation(fields: [user_device_action_id], references: [id], onDelete: Cascade)

  @@map("user_rule_actions")
}

model UserRuleEvent {
  id              Int      @id @default(autoincrement())
  rule_id         Int
  triggered_value String?  @db.VarChar(255)
  fired_at        DateTime @default(now()) @db.Timestamp(6)

  rule UserRule @relation(fields: [rule_id], references: [id], onDelete: Cascade)

  @@index([rule_id, fired_at])
  @@map("user_rule_events")
}

// Scenes (F10.5) — a user-named set of device actions executed on demand ("Good Night").
// Structurally a UserRule without conditions: firing is manual (POST /api/scenes/:id/execute)
// rather than condition-driven. Distinct from UserActionGroup, which is an organizational
// folder (exclusive group_id on the action, no target value); a SceneMember is a join row
// carrying the DESIRED value, so one action can belong to many scenes.
model Scene {
  id                    Int      @id @default(autoincrement())
  user_id               Int
  name                  String   @db.VarChar(255)
  sort_order            Int      @default(0)
  area_id               Int?
  // Blueprint provenance (F10) — see UserRule.
  blueprint_instance_id Int?
  blueprint_key         String?  @db.VarChar(64)
  // Set when this row came from a per_device template — which *binding* it belongs to (F11).
  // Reconcile identity is the pair (blueprint_key, blueprint_binding_id): several rows now share a
  // template key, one per bound device, and only the pair tells them apart.
  blueprint_binding_id  Int?
  // Phases this scene is offered in (F10). Empty = every phase. A scene is on-demand, so this
  // gates manual execution and dashboard visibility rather than automatic firing.
  phase_scope           String[] @default([])
  user_modified         Boolean  @default(false)
  created_at            DateTime @default(now()) @db.Timestamp(6)
  updated_at            DateTime @default(now()) @db.Timestamp(6)

  user               User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  area               Area?                 @relation(fields: [area_id], references: [id], onDelete: SetNull)
  blueprint_instance BlueprintInstance?    @relation(fields: [blueprint_instance_id], references: [id], onDelete: SetNull)
  blueprint_binding  BlueprintSlotBinding? @relation(fields: [blueprint_binding_id], references: [id], onDelete: SetNull)
  members            SceneMember[]

  @@unique([user_id, name])
  @@index([user_id, sort_order])
  @@index([area_id])
  @@index([blueprint_instance_id])
  @@map("scenes")
}

model SceneMember {
  id                    Int    @id @default(autoincrement())
  scene_id              Int
  user_device_action_id Int
  target_state          String  @db.VarChar(255)
  sort_order            Int     @default(0)
  // Staggered execution: members with a delay are published after it. Literal OR reference (F11.14).
  delay_seconds         String? @db.VarChar(100)
  // Held for this long by the DEVICE itself, then released — see user_rule_actions.duration_seconds.
  duration_seconds      String? @db.VarChar(100)

  scene              Scene            @relation(fields: [scene_id], references: [id], onDelete: Cascade)
  user_device_action UserDeviceAction @relation(fields: [user_device_action_id], references: [id], onDelete: Cascade)

  @@unique([scene_id, user_device_action_id])
  @@map("scene_members")
}

// ═══ Tier 5 — Pipelines (ML execution) ═════════════════════════════════════════

model Pipeline {
  id                    Int      @id @default(autoincrement())
  user_id               Int
  name                  String   @db.VarChar(255)
  enabled               Boolean  @default(true)
  area_id               Int?
  // Blueprint provenance (F10) — see UserRule.
  blueprint_instance_id Int?
  blueprint_key         String?  @db.VarChar(64)
  // Set when this row came from a per_device template — which *binding* it belongs to (F11).
  // Reconcile identity is the pair (blueprint_key, blueprint_binding_id): several rows now share a
  // template key, one per bound device, and only the pair tells them apart.
  blueprint_binding_id  Int?
  // Phases this pipeline's triggers are live in (F10). Empty = every phase; otherwise a trigger
  // only fires while the instance's current phase key is in the set. Gated at evaluation time.
  phase_scope           String[] @default([])
  user_modified         Boolean  @default(false)
  // See the note on user_rules.disabled_by_reconcile — same contract, same reason. Scenes need no
  // such column: they have no `enabled` at all, because a scene only ever runs when a user presses
  // it, so an orphaned one is inert by construction.
  disabled_by_reconcile Boolean  @default(false)
  created_at            DateTime @default(now()) @db.Timestamp(6)
  updated_at            DateTime @default(now()) @db.Timestamp(6)

  user               User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  area               Area?                 @relation(fields: [area_id], references: [id], onDelete: SetNull)
  blueprint_instance BlueprintInstance?    @relation(fields: [blueprint_instance_id], references: [id], onDelete: SetNull)
  blueprint_binding  BlueprintSlotBinding? @relation(fields: [blueprint_binding_id], references: [id], onDelete: SetNull)
  sensors            PipelineSensor[]
  stages             PipelineStage[]
  triggers           PipelineTrigger[]
  runs               PipelineRun[]

  @@index([area_id])
  @@index([blueprint_instance_id])
  @@map("pipelines")
}

model PipelineSensor {
  id                    Int     @id @default(autoincrement())
  pipeline_id           Int
  group_name            String  @db.VarChar(100)
  description           String  @db.VarChar(500)
  user_device_action_id Int
  inject_as_sensor      Boolean @default(true)
  inject_as_action      Boolean @default(false)
  min_value             String? @db.VarChar(50)
  max_value             String? @db.VarChar(50)
  compression           String  @default("average") @db.VarChar(20)
  window_minutes        Int     @default(60)
  n                     Int?

  pipeline           Pipeline         @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)
  user_device_action UserDeviceAction @relation(fields: [user_device_action_id], references: [id], onDelete: Cascade)

  @@unique([pipeline_id, user_device_action_id])
  @@index([pipeline_id, group_name])
  @@map("pipeline_sensors")
}

model PipelineStage {
  id                Int     @id @default(autoincrement())
  pipeline_id       Int
  ordinal           Int
  kind              String  @db.VarChar(20)
  ml_model_id       Int?
  // Typed columns per `kind`, not a JSON `config` blob — same treatment as user_rule_conditions.
  // JSON here is reserved for ML audit blobs and model/Google metadata.
  //   infer        → prompt_template (may embed @phase./@param., resolved by ml-router per run)
  //   command_exec → notify, execute_condition
  prompt_template   String? @db.Text
  notify            String? @db.VarChar(20)
  execute_condition String? @db.VarChar(20)

  pipeline   Pipeline           @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)
  ml_model   MlModel?           @relation(fields: [ml_model_id], references: [id], onDelete: Restrict)
  run_stages PipelineRunStage[]

  @@unique([pipeline_id, ordinal])
  @@map("pipeline_stages")
}

model PipelineTrigger {
  id                    Int       @id @default(autoincrement())
  pipeline_id           Int
  trigger_type          String    @db.VarChar(20)
  user_device_action_id Int?
  operator              String?   @db.VarChar(5)
  threshold_value       String?   @db.VarChar(100)
  // A schedule trigger, in the same shape a rule condition uses (see user_rule_conditions).
  // Replaces `schedule_cron`, which was stored, validated and NEVER evaluated — a pipeline with a
  // schedule trigger simply never ran. One shape for both, so there is one thing to learn and one
  // evaluator to keep correct. HH:MM literal OR a reference, resolved per run (F11.14).
  schedule_time         String? @db.VarChar(100)
  schedule_until         String? @db.VarChar(100)
  schedule_every_minutes Int?
  schedule_days          Int[]   @default([])
  min_interval_sec      Int?
  // Last time this trigger fired, used by automation-worker to enforce min_interval_sec.
  // Persisted here (not in Valkey) so cooldowns survive a restart and cannot double-fire.
  last_fired_at         DateTime? @db.Timestamp(6)

  pipeline           Pipeline          @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)
  user_device_action UserDeviceAction? @relation("PipelineTrig", fields: [user_device_action_id], references: [id], onDelete: Cascade)

  @@index([user_device_action_id])
  @@map("pipeline_triggers")
}

model PipelineRun {
  id               Int       @id @default(autoincrement())
  pipeline_id      Int
  status           String    @db.VarChar(20)
  trigger_type     String    @default("manual") @db.VarChar(20)
  trigger_payload  Json?
  is_dry_run       Boolean   @default(false)
  sensor_overrides Json?
  started_at       DateTime  @default(now()) @db.Timestamp(6)
  completed_at     DateTime? @db.Timestamp(6)

  pipeline Pipeline           @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)
  stages   PipelineRunStage[]

  @@index([pipeline_id, started_at])
  @@map("pipeline_runs")
}

model PipelineRunStage {
  id           Int       @id @default(autoincrement())
  run_id       Int
  stage_id     Int
  status       String    @db.VarChar(20)
  input        Json?
  output       Json?
  started_at   DateTime? @db.Timestamp(6)
  completed_at DateTime? @db.Timestamp(6)

  run   PipelineRun   @relation(fields: [run_id], references: [id], onDelete: Cascade)
  stage PipelineStage @relation(fields: [stage_id], references: [id], onDelete: Cascade)

  @@unique([run_id, stage_id])
  @@map("pipeline_run_stages")
}

// ═══ Tier 6 — Telemetry ════════════════════════════════════════════════════════

model SensorHistory {
  id                    Int              @id @default(autoincrement())
  user_device_action_id Int
  value                 String?          @db.Text // null on a fault reading (is_error)
  is_error              Boolean          @default(false)
  error_code            String?          @db.VarChar(100) // fault envelope's error code, e.g. "read_failed"
  recorded_at           DateTime         @default(now()) @db.Timestamp(6)
  user_device_action    UserDeviceAction @relation(fields: [user_device_action_id], references: [id], onDelete: Cascade)

  @@index([user_device_action_id, recorded_at])
  @@map("sensor_history")
}

// Every command the platform sends to a device — the write side's twin of sensor_history (F11.12).
//
// Until this existed a command left no trace: the in-flight record lived in Valkey under a TTL and
// the only durable evidence was `current_state`, which is the *last* value and says nothing about
// who set it, when, or whether it worked. "Why did the pump run at 3am" was unanswerable, and a
// command that was never acked was indistinguishable from one that was never sent.
//
// Written once, at dispatch — the single point every command passes through, whoever raised it —
// and settled in place when the device acks or the ack times out. `command_id` is the correlation
// key the device echoes back.
//
// A row that stays `sent` means no ack was ever seen. That is a real state, not a bug: only
// commands routed through digest's pending tracking are armed with a timeout, so a rule-issued
// command whose device is offline settles nowhere. Read it as "sent, unconfirmed".
model DeviceCommand {
  id                    Int      @id @default(autoincrement())
  user_id               Int
  // Resolved where known. A dispatch addresses a device + mqtt action name, and the id behind that
  // pair is looked up at write time; both are nullable so an unresolvable command is still recorded
  // rather than lost — that is exactly the case worth having history for.
  user_device_id        Int?
  user_device_action_id Int?
  action_name           String   @db.VarChar(64)
  target_state          String   @db.VarChar(255)
  // Seconds the DEVICE was told to hold the state before releasing it itself. Null = indefinitely.
  duration_seconds      Int?
  // Who raised it: manual | rule | scene | pipeline | phase | system. `source_ref_id` is that
  // thing's row id and `source_label` its name at dispatch time — kept as text on purpose, so the
  // history still reads correctly after the rule is renamed or deleted.
  source                String   @default("system") @db.VarChar(20)
  source_ref_id         Int?
  source_label          String?  @db.VarChar(255)
  // sent → ok | error | timeout. Never starts at "pending": by the time this row is written the
  // command is on its way to the broker.
  status                String   @default("sent") @db.VarChar(20)
  command_id            String?  @unique @db.VarChar(64)
  // The state the device reported back, which is not always the state it was asked for.
  result_value          String?  @db.VarChar(255)
  dispatched_at         DateTime @default(now()) @db.Timestamptz(6)
  settled_at            DateTime? @db.Timestamptz(6)

  user               User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_device        UserDevice?       @relation(fields: [user_device_id], references: [id], onDelete: SetNull)
  user_device_action UserDeviceAction? @relation(fields: [user_device_action_id], references: [id], onDelete: SetNull)

  // The two questions the history page asks: "what happened here" and "what happened to this".
  @@index([user_id, dispatched_at])
  @@index([user_device_action_id, dispatched_at])
  @@map("device_commands")
}

// ═══ Tier 7 — Blueprints (F10) ══════════════════════════════════════════════════
//
// A blueprint is an admin-authored description of a whole working multi-device setup; a user
// derives an *instance* of it, which binds their real devices and materializes the scenes,
// rules and pipelines. Two halves live here:
//
//   definition (admin, versioned, published)  Blueprint → slots / params / phases / *Template
//   instance   (user, live)                   BlueprintInstance → bindings / overrides
//
// Design notes that the field names alone don't carry (docs/plans/blueprints-redesign.md):
//
//  - Slots bind through a released SealedTemplate, never through a device type directly. That
//    tier already solves "which firmware version does this config apply to" and materializes
//    per-device config idempotently; a blueprint only adds the layer above it.
//  - Template entities address devices as (slot_key, action_name) rather than by row id, and
//    carry a stable `key` — that key is the *reconcile identity*, the thing that says "this
//    derived rule came from that template" across a v2 release.
//  - `action_name` is the sealed template ENTRY's mqtt_action_name, not a capability_key. A
//    template may activate the same capability several times (8 i2c_socket_8 channels →
//    socket, socket_2, …), so capability_key does not identify one action; mqtt_action_name is
//    exactly what materialization upserts user_device_actions on, so it is what derive resolves.
//  - Value fields accept a literal OR an `@param.x` / `@phase.x` reference resolved at
//    evaluation time by @lattice/params. Storing the reference (not the value) is what lets
//    reconcile, phase advance and user overrides write to disjoint places, so they cannot
//    clobber each other.

model Blueprint {
  id            Int      @id @default(autoincrement())
  key           String   @unique @db.VarChar(100)
  name          String   @db.VarChar(255)
  description   String?
  // Bumped on publish, NOT on every edit — instances record the version they were derived from,
  // and reconcile is what moves them forward.
  version       Int      @default(1)
  status        String   @default("draft") @db.VarChar(20) // draft | published (only published derives)
  // A **static** setup is one where no slot has phases — nothing in it is scheduled, anywhere.
  // Declared rather than inferred, because "this thing has no lifecycle" is an authoring decision:
  // a blueprint part-way through being written also has no phases yet, and the two must not look
  // alike. Publish enforces the agreement (static ⇒ no profiles, and vice versa), so the flag can
  // never disagree with the content.
  //
  // NOT the same as a blueprint whose *devices* own the schedules: a profiled slot means the phases
  // exist and belong to the bound devices, which is `BlueprintSlot.profiled`, not this.
  is_static     Boolean  @default(false)
  context_notes String? // free text handed to the LLM as setup context (F11)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @default(now()) @db.Timestamp(6)

  slots     BlueprintSlot[]
  params    BlueprintParam[]
  fields    BlueprintField[]
  profiles  BlueprintProfile[]
  scenes    BlueprintSceneTemplate[]
  rules     BlueprintRuleTemplate[]
  pipelines BlueprintPipelineTemplate[]
  instances BlueprintInstance[]

  @@map("blueprints")
}

// One device requirement. The sealed template decides what qualifies (device type + firmware
// version range); non-sealed, hand-configured devices are deliberately out of scope — a
// blueprint orchestrates factory-defined device types, nothing else.
model BlueprintSlot {
  id                 Int     @id @default(autoincrement())
  blueprint_id       Int
  key                String  @db.VarChar(64) // referenced by templates + bindings
  label              String  @db.VarChar(255)
  required           Boolean @default(true)
  min_count          Int     @default(1)
  max_count          Int     @default(1)
  // A profiled slot's bindings each choose a BlueprintProfile, so every device bound here walks
  // its own lifecycle (F11) — one setup holding several devices on independent schedules. An
  // unprofiled slot — a shared controller, say — has no lifecycle of its own and follows the setup.
  profiled           Boolean @default(false)
  sealed_template_id Int
  sort_order         Int     @default(0)

  blueprint       Blueprint      @relation(fields: [blueprint_id], references: [id], onDelete: Cascade)
  // Restrict: a sealed template with live blueprint slots must not vanish underneath them.
  sealed_template SealedTemplate @relation(fields: [sealed_template_id], references: [id], onDelete: Restrict)

  @@unique([blueprint_id, key])
  @@map("blueprint_slots")
}

// The declared tuning surface. Anything a phase can set or a user can override must be declared
// here first, so the builder UI, write-time validation and the instance page all work off one list.
model BlueprintParam {
  id            Int     @id @default(autoincrement())
  blueprint_id  Int
  key           String  @db.VarChar(64) // "humidity.min" — what @param./@phase. resolves against
  label         String  @db.VarChar(255)
  default_value String  @db.VarChar(100)
  unit          String? @db.VarChar(20)
  user_tunable  Boolean @default(true) // false ⇒ phase-driven only, no override UI
  sort_order    Int     @default(0)

  blueprint Blueprint @relation(fields: [blueprint_id], references: [id], onDelete: Cascade)

  @@unique([blueprint_id, key])
  @@map("blueprint_params")
}

// A question the blueprint asks the user at derive time (F11.6) — what this device is handling,
// when its process started, which variant it is. Params are values the *system* tunes; a field is a
// fact the user states, so it is a separate declaration with its own reference kind (`@field.x`).
//
// A field resolves to one stated string. It deliberately does NOT go through the param precedence:
// no phase retunes a fact, so the only order is binding value → setup value → default → null.
model BlueprintField {
  id            Int     @id @default(autoincrement())
  blueprint_id  Int
  key           String  @db.VarChar(64) // "variant" — what @field.variant resolves against
  label         String  @db.VarChar(255) // the question as the user reads it
  help_text     String?
  input_type    String  @default("text") @db.VarChar(20) // text | number | select | date | boolean
  // setup   asked once for the whole setup
  // binding asked once per bound device of `slot_key`
  scope         String  @default("setup") @db.VarChar(20)
  slot_key      String? @db.VarChar(64) // scope=binding: whose bindings are asked
  required      Boolean @default(false)
  default_value String? @db.VarChar(500)
  sort_order    Int     @default(0)

  blueprint Blueprint              @relation(fields: [blueprint_id], references: [id], onDelete: Cascade)
  options   BlueprintFieldOption[]

  @@unique([blueprint_id, key])
  @@map("blueprint_fields")
}

// One choice of a `select` field. `profile_key` is the load-bearing bit: picking an option stores
// the descriptive answer AND puts that binding on the named lifecycle, so one question sets both
// facts — and two bindings can share a profile while still carrying different answers.
model BlueprintFieldOption {
  id          Int     @id @default(autoincrement())
  field_id    Int
  value       String  @db.VarChar(255) // what @field.x resolves to
  label       String  @db.VarChar(255)
  profile_key String? @db.VarChar(64) // choosing this option puts the binding on this profile
  sort_order  Int     @default(0)

  field BlueprintField @relation(fields: [field_id], references: [id], onDelete: Cascade)

  @@unique([field_id, value])
  @@map("blueprint_field_options")
}

// A named lifecycle a bound device can follow — what it is handling decides its schedule (F11).
//
// Runtime content exactly like a phase name: the engine never knows what a profile *means*, only
// that it has these phases in this order. A blueprint declares the profiles it supports; the user
// picks one per binding of a profiled slot.
//
// Every blueprint has at least one profile. A blueprint that is a single lifecycle (the F10 shape)
// simply has one, which is why phases hang off a profile rather than off the blueprint: one code
// path serves both instead of two that must agree.
model BlueprintProfile {
  id           Int    @id @default(autoincrement())
  blueprint_id Int
  key          String @db.VarChar(64) // reconcile identity, referenced by a binding
  label        String @db.VarChar(255)
  sort_order   Int    @default(0)

  blueprint Blueprint        @relation(fields: [blueprint_id], references: [id], onDelete: Cascade)
  phases    BlueprintPhase[]

  @@unique([blueprint_id, key])
  @@map("blueprint_profiles")
}

// An ordered lifecycle step within a profile. Advancing writes the phase columns of whatever owns
// the lifecycle — the instance, or one binding — and retunes every @phase reference at once; no
// rule, scene or pipeline row is rewritten.
//
// Phase keys are unique per *profile*, not per blueprint: one key may mean a different length and
// different targets in two profiles, and a phase_scope naming it matches whichever profile the
// binding follows.
model BlueprintPhase {
  id             Int     @id @default(autoincrement())
  profile_id     Int
  key            String  @db.VarChar(64)
  name           String  @db.VarChar(255)
  ordinal        Int
  // A literal ("7") OR a reference resolved against the owner's context — `@param.seedling.days`,
  // `@field.x` (F11.13). A reference is what lets ONE lifecycle hold devices whose phases run for
  // different lengths: two pots follow the same three phases, and the pot that needs a shorter
  // seedling overrides that param for itself. Before this, a duration lived on the phase, the phase
  // belongs to the lifecycle, and the only way to change one number was to duplicate the lifecycle.
  //
  // Text rather than Int for the same reason every other value position is text: the reference must
  // survive to evaluation time, because that is the only moment the answer is known.
  duration_value String? @db.VarChar(100)
  duration_unit  String? @db.VarChar(10) // seconds | minutes | hours | days | weeks | months
  // What ends this phase (F11.x). One trigger per phase; the phase owns the target, the referenced
  // automation only supplies the *decision*.
  //   manual    only a person advances it (start / setPhase).
  //   schedule  the elapsed-duration cron — the old `auto_advance`. Needs duration_value/unit.
  //   rule      the derived UserRule of `advance_ref_key` firing advances the phase.
  //   pipeline  the derived Pipeline of `advance_ref_key` returning phase_transition.advance=true.
  // The decider must match the lifecycle level: a phase in a profiled slot's profile is advanced by
  // a per_device automation over that slot (⇒ that pot); a plain setup's phase by a combined one
  // (⇒ the instance). Enforced at publish, not here.
  advance_mode    String  @default("manual") @db.VarChar(20)
  advance_ref_key String? @db.VarChar(64) // rule/pipeline template key, for modes rule|pipeline
  advance_to_key  String? @db.VarChar(64) // target phase key in THIS profile; null = next by ordinal
  context_notes  String? // resolved by @phase.context_notes, e.g. into an LLM prompt

  profile   BlueprintProfile       @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  targets   BlueprintPhaseTarget[]
  instances BlueprintInstance[]
  bindings  BlueprintSlotBinding[]

  @@unique([profile_id, key])
  @@index([profile_id, ordinal])
  @@map("blueprint_phases")
}

// What this phase sets a param to. No row ⇒ the param's own default applies in this phase.
model BlueprintPhaseTarget {
  id        Int    @id @default(autoincrement())
  phase_id  Int
  param_key String @db.VarChar(64)
  value     String @db.VarChar(100)

  phase BlueprintPhase @relation(fields: [phase_id], references: [id], onDelete: Cascade)

  @@unique([phase_id, param_key])
  @@map("blueprint_phase_targets")
}

// ─── Template entities — mirror their concrete counterparts, addressed by slot ──────────────

model BlueprintSceneTemplate {
  id               Int      @id @default(autoincrement())
  blueprint_id     Int
  key              String   @db.VarChar(64) // reconcile identity
  name             String   @db.VarChar(255)
  sort_order       Int      @default(0)
  phase_scope      String[] @default([]) // phase keys this scene is offered in; empty = all phases
  // How this template materialises over a multi-device slot (F11):
  //   combined   (default) one entity naming every bound device — "if any of them reports X".
  //   per_device one entity PER bound device, each carrying blueprint_binding_id and resolving
  //              against that binding's own phase — the only shape that can hold @phase. once the
  //              bound devices disagree about which phase they are in.
  // `fan_out_slot_key` names the slot driving the split; required for per_device.
  // `fan_out_profiles` narrows WHICH of that slot's devices take part (F11.9); empty = all of
  // them. Together the two answer "one / some / all": per_device is one automation per device,
  // combined is one over the group, and a non-empty profile list makes either cover a subset.
  fan_out          String   @default("combined") @db.VarChar(20)
  fan_out_slot_key String?  @db.VarChar(64)
  fan_out_profiles String[] @default([])

  blueprint Blueprint                      @relation(fields: [blueprint_id], references: [id], onDelete: Cascade)
  members   BlueprintSceneTemplateMember[]

  @@unique([blueprint_id, key])
  @@map("blueprint_scene_templates")
}

model BlueprintSceneTemplateMember {
  id            Int    @id @default(autoincrement())
  template_id   Int
  slot_key      String @db.VarChar(64) // ← together these replace user_device_action_id
  action_name   String @db.VarChar(64) // ← the slot's sealed template entry mqtt_action_name
  target_state  String  @db.VarChar(255) // literal OR "@param.pump_speed"
  sort_order    Int     @default(0)
  delay_seconds String? @db.VarChar(100) // literal OR a reference (F11.14)
  // Held for this long by the DEVICE itself, then released — see user_rule_actions.duration_seconds.
  duration_seconds String? @db.VarChar(100) // literal OR "@phase.water.seconds"

  template BlueprintSceneTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@unique([template_id, slot_key, action_name])
  @@map("blueprint_scene_template_members")
}

model BlueprintRuleTemplate {
  id                 Int      @id @default(autoincrement())
  blueprint_id       Int
  key                String   @db.VarChar(64) // reconcile identity
  name               String   @db.VarChar(255)
  is_emergency       Boolean  @default(false)
  condition_operator String   @default("AND") @db.VarChar(3)
  cooldown_seconds   Int      @default(60)
  phase_scope        String[] @default([]) // phase keys this rule is active in; empty = all phases
  // How this template materialises over a multi-device slot (F11):
  //   combined   (default) one entity naming every bound device — "if any of them reports X".
  //   per_device one entity PER bound device, each carrying blueprint_binding_id and resolving
  //              against that binding's own phase — the only shape that can hold @phase. once the
  //              bound devices disagree about which phase they are in.
  // `fan_out_slot_key` names the slot driving the split; required for per_device.
  // `fan_out_profiles` narrows WHICH of that slot's devices take part (F11.9); empty = all of
  // them. Together the two answer "one / some / all": per_device is one automation per device,
  // combined is one over the group, and a non-empty profile list makes either cover a subset.
  fan_out            String   @default("combined") @db.VarChar(20)
  fan_out_slot_key   String?  @db.VarChar(64)
  fan_out_profiles   String[] @default([])

  blueprint  Blueprint                        @relation(fields: [blueprint_id], references: [id], onDelete: Cascade)
  conditions BlueprintRuleTemplateCondition[]
  actions    BlueprintRuleTemplateAction[]

  @@unique([blueprint_id, key])
  @@map("blueprint_rule_templates")
}

model BlueprintRuleTemplateCondition {
  id              Int     @id @default(autoincrement())
  template_id     Int
  condition_type  String  @db.VarChar(20) // threshold | device_status | schedule
  slot_key        String? @db.VarChar(64)
  action_name     String? @db.VarChar(64)
  operator        String? @db.VarChar(5)
  threshold_value String? @db.VarChar(100) // literal OR "@phase.humidity.min"
  status_value    String? @db.VarChar(20)
  schedule_time   String? @db.VarChar(100) // HH:MM literal OR "@phase.light.on_time" (F11.14)
  schedule_days   Int[]   @default([])
  // A schedule is one minute a day unless a WINDOW is given, in which case it repeats:
  // `schedule_time` opens it, `schedule_until` closes it (inclusive) and `schedule_every_minutes`
  // is the step — "06:00 to 17:30, every 10 minutes". Both window columns null = the single-time
  // shape every schedule had before, unchanged. How long the device then holds the state is the
  // action's own duration_seconds, not this: this says WHEN, that says HOW LONG.
  schedule_until    String? @db.VarChar(100)
  schedule_every_minutes   Int?


  template BlueprintRuleTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@map("blueprint_rule_template_conditions")
}

model BlueprintRuleTemplateAction {
  id            Int    @id @default(autoincrement())
  template_id   Int
  slot_key      String @db.VarChar(64)
  action_name   String @db.VarChar(64)
  target_state  String  @db.VarChar(255) // literal OR "@param.pump_speed"
  delay_seconds String? @db.VarChar(100) // literal OR a reference (F11.14)
  // Held for this long by the DEVICE itself, then released — see user_rule_actions.duration_seconds.
  duration_seconds String? @db.VarChar(100) // literal OR "@phase.water.seconds"

  template BlueprintRuleTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@map("blueprint_rule_template_actions")
}

model BlueprintPipelineTemplate {
  id               Int      @id @default(autoincrement())
  blueprint_id     Int
  key              String   @db.VarChar(64) // reconcile identity
  name             String   @db.VarChar(255)
  enabled          Boolean  @default(true)
  phase_scope      String[] @default([]) // phase keys this pipeline's triggers are live in; empty = all
  // How this template materialises over a multi-device slot (F11):
  //   combined   (default) one entity naming every bound device — "if any of them reports X".
  //   per_device one entity PER bound device, each carrying blueprint_binding_id and resolving
  //              against that binding's own phase — the only shape that can hold @phase. once the
  //              bound devices disagree about which phase they are in.
  // `fan_out_slot_key` names the slot driving the split; required for per_device.
  // `fan_out_profiles` narrows WHICH of that slot's devices take part (F11.9); empty = all of
  // them. Together the two answer "one / some / all": per_device is one automation per device,
  // combined is one over the group, and a non-empty profile list makes either cover a subset.
  fan_out          String   @default("combined") @db.VarChar(20)
  fan_out_slot_key String?  @db.VarChar(64)
  fan_out_profiles String[] @default([])

  blueprint Blueprint                          @relation(fields: [blueprint_id], references: [id], onDelete: Cascade)
  sensors   BlueprintPipelineTemplateSensor[]
  stages    BlueprintPipelineTemplateStage[]
  triggers  BlueprintPipelineTemplateTrigger[]

  @@unique([blueprint_id, key])
  @@map("blueprint_pipeline_templates")
}

model BlueprintPipelineTemplateSensor {
  id               Int     @id @default(autoincrement())
  template_id      Int
  group_name       String  @db.VarChar(100)
  description      String  @db.VarChar(500)
  slot_key         String  @db.VarChar(64)
  action_name      String  @db.VarChar(64)
  inject_as_sensor Boolean @default(true)
  inject_as_action Boolean @default(false)
  // Bounds are the pipeline-side @phase references: what "normal" means changes per phase.
  min_value        String? @db.VarChar(50)
  max_value        String? @db.VarChar(50)
  compression      String  @default("average") @db.VarChar(20)
  window_minutes   Int     @default(60)
  n                Int?

  template BlueprintPipelineTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@unique([template_id, slot_key, action_name])
  @@map("blueprint_pipeline_template_sensors")
}

model BlueprintPipelineTemplateStage {
  id                Int     @id @default(autoincrement())
  template_id       Int
  ordinal           Int
  kind              String  @db.VarChar(20)
  ml_model_id       Int?
  // Mirrors PipelineStage's typed stage columns, for the same reason.
  prompt_template   String? @db.Text
  notify            String? @db.VarChar(20)
  execute_condition String? @db.VarChar(20)

  template BlueprintPipelineTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  ml_model MlModel?                  @relation(fields: [ml_model_id], references: [id], onDelete: Restrict)

  @@unique([template_id, ordinal])
  @@map("blueprint_pipeline_template_stages")
}

model BlueprintPipelineTemplateTrigger {
  id               Int     @id @default(autoincrement())
  template_id      Int
  trigger_type     String  @db.VarChar(20)
  slot_key         String? @db.VarChar(64)
  action_name      String? @db.VarChar(64)
  operator         String? @db.VarChar(5)
  threshold_value  String? @db.VarChar(100) // literal OR a reference
  // A schedule trigger, in the same shape a rule condition uses (see user_rule_conditions).
  // Replaces `schedule_cron`, which was stored, validated and NEVER evaluated — a pipeline with a
  // schedule trigger simply never ran. One shape for both, so there is one thing to learn and one
  // evaluator to keep correct. HH:MM literal OR a reference, resolved per run (F11.14).
  schedule_time    String? @db.VarChar(100)
  schedule_until    String? @db.VarChar(100)
  schedule_every_minutes Int?
  schedule_days     Int[]   @default([])
  min_interval_sec Int?

  template BlueprintPipelineTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@map("blueprint_pipeline_template_triggers")
}

// ─── Instance — user-owned ──────────────────────────────────────────────────────────────────

// Deriving a setup builds it; it does not start it. `lifecycle_state` is that distinction:
//
//   not_started  no phase, no clock — the user has not said the real-world process began
//   running      a phase is current and its clock is ticking
//   stopped      the phase is remembered, the clock is parked (phase_started_at = null)
//
// Connecting a device says nothing about when the thing it watches actually started, so the start
// instant is a decision the user makes — with a phase and a position inside it — not a side effect
// of finishing the wizard. **Nothing derived from a setup acts while it is not running**: the gate
// is `isAutomationLive` in @lattice/params, applied by the rule engine, pipeline triggers and scene
// execution alike. That includes emergency rules — stopping a setup stops all of it.
model BlueprintInstance {
  id                Int       @id @default(autoincrement())
  user_id           Int
  blueprint_id      Int
  blueprint_version Int // the version this was derived from / last reconciled to
  area_id           Int
  name              String    @db.VarChar(255)
  lifecycle_state   String    @default("not_started") @db.VarChar(20)
  current_phase_id  Int?
  // Start of the CURRENT run. Null whenever the clock is not ticking (not_started or stopped),
  // which is also what makes the auto-advance cron structurally unable to move a stopped setup.
  phase_started_at  DateTime? @db.Timestamp(6)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @default(now()) @db.Timestamp(6)

  user          User                          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  // Restrict: a blueprint with live instances must not be deletable out from under them.
  blueprint     Blueprint                     @relation(fields: [blueprint_id], references: [id], onDelete: Restrict)
  area          Area                          @relation(fields: [area_id], references: [id], onDelete: Cascade)
  current_phase BlueprintPhase?               @relation(fields: [current_phase_id], references: [id], onDelete: SetNull)
  bindings      BlueprintSlotBinding[]
  overrides     BlueprintParamOverride[]
  phase_state   BlueprintInstancePhaseState[]
  field_values  BlueprintInstanceFieldValue[]
  scenes        Scene[]
  rules         UserRule[]
  pipelines     Pipeline[]

  @@unique([user_id, name])
  @@index([blueprint_id])
  @@map("blueprint_instances")
}

// One device in a setup — and, when its slot is profiled, a thing with its own name, its own
// profile, and its own place in that profile's lifecycle (F11).
//
// That is what lets ONE setup hold devices on independent schedules: a shared controller
// (unprofiled, no lifecycle of its own) alongside a binding per device that walks its own phases.
// The phase columns mirror BlueprintInstance's exactly, because they mean the same thing one level
// down and the same timer helpers serve both.
model BlueprintSlotBinding {
  id               Int       @id @default(autoincrement())
  instance_id      Int
  // Plain string, not an FK: the binding survives the slot row being edited or replaced by a
  // later blueprint version, which is the whole point of key-based reconcile identity.
  slot_key         String    @db.VarChar(64)
  user_device_id   Int
  auto_bound       Boolean   @default(false) // bound with no user input (exactly one candidate)
  // What the user calls this one. Null falls back to the device's own name.
  label            String?   @db.VarChar(255)
  // Which BlueprintProfile this binding follows. Null on an unprofiled slot — a shared device has
  // no lifecycle of its own. A key, not an FK, for the same reason slot_key is one.
  profile_key      String?   @db.VarChar(64)
  // Per-binding lifecycle, meaning what it means on the instance: not_started | running | stopped.
  // A binding is live only while its setup is too, so both gates are read at evaluation time.
  lifecycle_state  String    @default("not_started") @db.VarChar(20)
  current_phase_id Int?
  phase_started_at DateTime? @db.Timestamp(6)

  instance      BlueprintInstance               @relation(fields: [instance_id], references: [id], onDelete: Cascade)
  user_device   UserDevice                      @relation(fields: [user_device_id], references: [id], onDelete: Cascade)
  current_phase BlueprintPhase?                 @relation(fields: [current_phase_id], references: [id], onDelete: SetNull)
  phase_state   BlueprintBindingPhaseState[]
  overrides     BlueprintBindingParamOverride[]
  field_values  BlueprintBindingFieldValue[]
  // What a per_device template materialised for THIS device (F11.2).
  scenes        Scene[]
  rules         UserRule[]
  pipelines     Pipeline[]

  // A device belongs to at most ONE setup, and fills at most one slot of it. Derive checks this
  // before it writes, but that read happens outside the transaction and nothing backed it, so two
  // concurrent derives could bind the same board twice and leave two setups both commanding it.
  // The constraint is the invariant; the check is only there to produce a friendly message first.
  @@unique([user_device_id])
  @@unique([instance_id, slot_key, user_device_id])
  @@map("blueprint_slot_bindings")
}

// Time banked per phase for ONE binding — the per-binding twin of blueprint_instance_phase_state,
// the same contract: written when the binding leaves a phase, and the live run is never in here.
//
// A sibling table rather than a nullable binding_id on the instance-level one: Postgres treats
// NULLs as distinct in a unique index, so (instance_id, NULL, phase_key) would admit duplicates,
// and Prisma's upsert needs a compound unique it can name. The same reasoning gave
// BlueprintParamOverride.phase_key its empty-string sentinel.
model BlueprintBindingPhaseState {
  id              Int       @id @default(autoincrement())
  binding_id      Int
  phase_key       String    @db.VarChar(64)
  accrued_seconds Int       @default(0)
  last_exited_at  DateTime? @db.Timestamp(6)
  updated_at      DateTime  @default(now()) @db.Timestamp(6)

  binding BlueprintSlotBinding @relation(fields: [binding_id], references: [id], onDelete: Cascade)

  @@unique([binding_id, phase_key])
  @@map("blueprint_binding_phase_state")
}

// The user's tuning for ONE binding — "this device wants a different number". Beats the setup-wide
// override, which beats the profile's phase target, which beats the blueprint default. Same shape
// and same empty-string phase scoping as BlueprintParamOverride, one level down.
model BlueprintBindingParamOverride {
  id         Int    @id @default(autoincrement())
  binding_id Int
  param_key  String @db.VarChar(64)
  phase_key  String @default("") @db.VarChar(64)
  value      String @db.VarChar(100)

  binding BlueprintSlotBinding @relation(fields: [binding_id], references: [id], onDelete: Cascade)

  @@unique([binding_id, param_key, phase_key])
  @@map("blueprint_binding_param_overrides")
}

// What the user answered to a setup-scoped BlueprintField (F11.6). Keyed by field *key*, like every
// other user-owned blueprint table, so a v2 publish that recreates the field rows does not discard
// the answer.
model BlueprintInstanceFieldValue {
  id          Int    @id @default(autoincrement())
  instance_id Int
  field_key   String @db.VarChar(64)
  value       String @db.VarChar(500)

  instance BlueprintInstance @relation(fields: [instance_id], references: [id], onDelete: Cascade)

  @@unique([instance_id, field_key])
  @@map("blueprint_instance_field_values")
}

// The same, one level down: what the user answered about ONE binding. Sibling table rather than a
// nullable binding_id, for the reason given on BlueprintBindingPhaseState.
model BlueprintBindingFieldValue {
  id         Int    @id @default(autoincrement())
  binding_id Int
  field_key  String @db.VarChar(64)
  value      String @db.VarChar(500)

  binding BlueprintSlotBinding @relation(fields: [binding_id], references: [id], onDelete: Cascade)

  @@unique([binding_id, field_key])
  @@map("blueprint_binding_field_values")
}

// The user's own tuning. Beats the phase target and the blueprint default. Reconcile never
// touches this table — that is what makes a v2 release non-destructive to user intent.
// The user's own value for a param — always per *instance*, never on the blueprint, so two
// instances of the same blueprint can be tuned independently without either touching the shared
// template. `phase_key` narrows it further: "" means every phase, a phase key means that phase
// alone, so correcting one phase is no longer the same act as opting out of the schedule.
//
// "" rather than NULL because Postgres treats NULLs as distinct in a unique index (two all-phases
// rows would both be accepted) and Prisma cannot take a null component in a compound-unique where,
// which the upsert in blueprints.instances.service depends on.
model BlueprintParamOverride {
  id          Int    @id @default(autoincrement())
  instance_id Int
  param_key   String @db.VarChar(64)
  phase_key   String @default("") @db.VarChar(64)
  value       String @db.VarChar(100)

  instance BlueprintInstance @relation(fields: [instance_id], references: [id], onDelete: Cascade)

  @@unique([instance_id, param_key, phase_key])
  @@map("blueprint_param_overrides")
}

// How long the instance has *already* spent in each phase, banked when it leaves. The phase it is
// in right now is not counted here — the live run is `now - phase_started_at`, added at read time
// — so a running timer costs no writes and needs no cron of its own.
//
// This is what makes rolling a phase back a real undo rather than a restart: leaving banks the
// time, and re-entering can either spend that bank ("resume"), discard it ("reset") or replace it
// with a value the user names. Only a person spends a bank — auto-advance always resets, so the
// clock alone can never resurrect time from an earlier visit.
//
// Keyed by phase *key*, like BlueprintParamOverride and for the same reason: a v2 publish can
// recreate the phase rows, and time spent in "vegetative" should survive that. A key that no
// longer names a phase is simply never read — kept rather than pruned, so re-adding the phase in a
// later version restores its bank.
model BlueprintInstancePhaseState {
  id              Int       @id @default(autoincrement())
  instance_id     Int
  phase_key       String    @db.VarChar(64)
  // Seconds, not milliseconds: an Int of seconds spans 68 years, while a BigInt of milliseconds
  // cannot be JSON.stringify'd and would break the instance response.
  accrued_seconds Int       @default(0)
  last_exited_at  DateTime? @db.Timestamp(6)
  updated_at      DateTime  @default(now()) @db.Timestamp(6)

  instance BlueprintInstance @relation(fields: [instance_id], references: [id], onDelete: Cascade)

  @@unique([instance_id, phase_key])
  @@map("blueprint_instance_phase_state")
}
