          "action_name": "i2c_socket_8_2",
          "target_state": "off",
          "sort_order": 1
        },
        {
          "slot_key": "pots",
          "action_name": "i2c_socket_8",
          "target_state": "on",
          "sort_order": 2,
          "delay_seconds": "@param.water.stagger_seconds",
          "duration_seconds": "@phase.water.seconds"
        }
      ]
    },
    {
      "key": "herbs_lights_out",
      "name": "Herb lights out",
      "sort_order": 3,
      "fan_out": "combined",
      "fan_out_slot_key": "pots",
      "fan_out_profiles": ["herbs"],
      "members": [{ "slot_key": "pots", "action_name": "i2c_socket_8_2", "target_state": "off" }]
    }
  ],
  "pipelines": [
    {
      "key": "readiness",
      "name": "Is this pot ready?",
      "enabled": true,
      "fan_out": "per_device",
      "fan_out_slot_key": "pots",
      "phase_scope": ["growth", "flowering"],
      "sensors": [
        {
          "group_name": "pot",
          "description": "valve state — how much this pot has been drinking",
          "slot_key": "pots",
          "action_name": "i2c_socket_8",
          "inject_as_sensor": true,
          "compression": "last_n",
          "n": 8,
          "window_minutes": 1440
        },
        {
          "group_name": "reservoir",
          "description": "reservoir level over the last day",
          "slot_key": "reservoir",
          "action_name": "water_level",
          "inject_as_sensor": true,
          "min_value": "@param.reservoir.min",
          "max_value": "100",
          "compression": "min_max_avg",
          "window_minutes": 1440
        }
      ],
      "stages": [
        {
          "ordinal": 1,
          "kind": "infer",
          "ml_model": { "kind": "llm", "name": "gemini", "version": "v1" },
          "prompt_template": "This pot is growing @field.plant (@field.variety) in @field.pot_litres litres, planted @field.planted_on, and the garden is in @field.season. It is in its @phase.name stage, watered for @phase.water.seconds seconds a run. @phase.context_notes\nDecide only whether this stage is finished and the pot should move on. It is not a threshold — say no unless the readings and the time in stage together make it clear."
        },
        {
          "ordinal": 2,
          "kind": "command_exec",
          "notify": "socket",
          "execute_condition": "on_positive"
        }
      ],
      "triggers": [
        {
          "trigger_type": "schedule",
          "schedule_time": "@param.check.time",
          "schedule_days": [],
          "min_interval_sec": 43200
        },
        { "trigger_type": "manual" }
      ]
    },
    {
      "key": "water_budget",
      "name": "Share the reservoir",
      "enabled": true,
      "fan_out": "combined",
      "sensors": [
        {
          "group_name": "reservoir",
          "description": "how much water is left",
          "slot_key": "reservoir",
          "action_name": "water_level",
          "inject_as_sensor": true,
          "min_value": "@param.reservoir.min",
          "compression": "average",
          "window_minutes": 60
        },
        {
          "group_name": "pot",
          "description": "each pot's valve — readable, and openable by the decision",
          "slot_key": "pots",
          "action_name": "i2c_socket_8",
          "inject_as_sensor": true,
          "inject_as_action": true,
          "compression": "time_series",
          "window_minutes": 60
        }
      ],
      "stages": [
        {
          "ordinal": 1,
          "kind": "infer",
          "ml_model": { "kind": "llm", "name": "gemini", "version": "v1" },
          "prompt_template": "The reservoir is shared by every pot below, and each pot is at its own stage with its own expected range. Water is short — hold anything under @param.reservoir.min in reserve. Decide which pots to open now and which can wait until the next run; open nothing you cannot justify from the stage and the readings. Prefer the stage that suffers most from a missed watering."
        },
        {
          "ordinal": 2,
          "kind": "command_exec",
          "notify": "push",
          "execute_condition": "always"
        }
      ],
      "triggers": [
        {
          "trigger_type": "sensor_threshold",
