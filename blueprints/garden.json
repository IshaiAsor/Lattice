      "conditions": [
        {
          "condition_type": "threshold",
          "slot_key": "reservoir",
          "action_name": "water_level",
          "operator": "<",
          "threshold_value": "@param.reservoir.min"
        },
        {
          "condition_type": "threshold",
          "slot_key": "reservoir",
          "action_name": "water_level",
          "operator": "<=",
          "threshold_value": "@param.reservoir.critical"
