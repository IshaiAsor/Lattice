          "threshold_value": "@param.reservoir.min",
          "min_interval_sec": 1800
        },
        {
          "trigger_type": "schedule",
          "schedule_time": "06:30",
          "schedule_until": "19:30",
          "schedule_every_minutes": 180,
          "schedule_days": [1, 2, 3, 4, 5, 6, 0],
          "min_interval_sec": 3600
        }
      ]
    }
  ]
