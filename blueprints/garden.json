{
  "key": "garden_pots",
  "name": "Garden — pots on their own schedules",
  "description": "One shared reservoir plus up to six pots. Each pot is asked what is growing in it, and that answer puts it on its own schedule — so pots can sit at different stages at once, each with its own watering and light thresholds. Authored as the worked example that exercises every blueprint capability: four lifecycles, all five question types, all four ways a phase can end, both fan-out modes with lifecycle selectors and phase gates, and a two-stage pipeline that decides and then acts.",
  "context_notes": "A garden of individually planted pots fed from one reservoir. Pots do not share a stage: read each pot's own phase and its own expected ranges before deciding anything. The reservoir is shared, so watering several pots at once drains it faster than watering one.",
  "is_static": false,
  "slots": [
    {
      "key": "reservoir",
      "label": "Reservoir",
      "sealed_template": "Tank Monitor Board",
      "required": true,
      "min_count": 1,
      "max_count": 1,
      "profiled": false,
      "sort_order": 1
    },
    {
      "key": "pots",
      "label": "Pots",
      "sealed_template": "Socket Board 2ch",
      "required": true,
      "min_count": 1,
      "max_count": 6,
      "profiled": true,
      "sort_order": 2
    }
  ],
  "fields": [
